// secrets.h.example — copy to secrets.h (git-ignored) and fill in. NEVER commit secrets.h.
// Contract: 00_lead/INTERFACES.md v0.2 section 1.
#pragma once

// --- WiFi: primary (e.g. presenter phone hotspot) and optional secondary (venue WiFi) ---
#define WIFI_SSID      "your-hotspot-ssid"
#define WIFI_PASS      "your-hotspot-password"
#define WIFI_SSID_2    ""          // leave "" if unused
#define WIFI_PASS_2    ""

// --- Device identity (key issued by Software, out-of-band) ---
#define DEVICE_ID      "cam-01"
#define DEVICE_KEY     "replace-with-device-key"

// --- Backend base URLs (no trailing slash) ---
// Cloud: HTTPS with pinned root CA. Local fallback: plain HTTP to the presenter laptop (allowed only here).
#define API_BASE       "https://your-app.azurewebsites.net"
#define API_BASE_LOCAL "http://192.168.43.100:8000"

// --- TLS ---
// Paste the PEM root CA that signs the API_BASE certificate. Get it with:
//   openssl s_client -connect your-app.azurewebsites.net:443 -showcerts </dev/null
// and copy the LAST certificate in the chain (the root), including BEGIN/END lines.
static const char ROOT_CA[] = R"PEM(
-----BEGIN CERTIFICATE-----
REPLACE_WITH_ROOT_CA
-----END CERTIFICATE-----
)PEM";

// Emergency switch ONLY (e.g. cert rotated on demo day): 1 = skip certificate check.
// Keep 0 in normal use; record in the demo log if you ever set it to 1.
#define ALLOW_INSECURE_TLS 0
